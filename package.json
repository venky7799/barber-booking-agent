{
  "name": "barber-booking-agent",
  "version": "1.0.0",
  "description": "Cost-optimized multi-tenant barber booking agent for WhatsApp and phone calls",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "seed": "tsx src/seed-cli.ts",
    "demo:book": "tsx src/scripts/demo-book.ts",
    "whatsapp:webhook": "tsx src/scripts/register-whatsapp-webhook.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "barber",
    "booking",
    "whatsapp",
    "twilio",
    "ivr"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/openai": "^1.5.13",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "googleapis": "^181.0.0",
    "twilio": "^6.1.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
