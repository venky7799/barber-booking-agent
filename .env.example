PORT=3000
DATABASE_PATH=./data/barber.db
PUBLIC_BASE_URL=http://localhost:3000

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=barber_verify_token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Optional: digits of the WhatsApp business/test number (used to map FADE01)
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_APP_ID=

# Twilio Voice / SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional LangChain fallback (OpenAI-compatible). Buttons/numbers work without this.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Google Sheets + Calendar (service account JSON). Share the sheet and calendar with the SA email.
GOOGLE_SERVICE_ACCOUNT_JSON=
# or GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Bookings
GOOGLE_CALENDAR_ID=
